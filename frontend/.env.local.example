# Optional: call the API directly from the browser (skips Next.js proxy).
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side proxy target for /api and /health (used by next.config.ts rewrites).
# On Vercel: set API_URL to your deployed FastAPI URL (e.g. https://your-api.railway.app).
API_URL=http://localhost:8000
